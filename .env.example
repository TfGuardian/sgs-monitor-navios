SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sb_publishable_sua_chave_publica
# Chave secreta usada apenas pelo monitor no servidor. Nunca envie ao navegador.
SUPABASE_SECRET_KEY=sb_secret_sua_chave_secreta

# WhatsApp Cloud API oficial da Meta
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_RECIPIENT_PHONE=5513999999999
META_TEMPLATE_NAME=alerta_monitoramento_navio
META_TEMPLATE_LANGUAGE=pt_BR
META_GRAPH_API_VERSION=v26.0
# Modelo de 12 parametros definido em RELATORIO_HORARIO.md (Meta deve aprovar).
META_REPORT_TEMPLATE_NAME=relatorio_horario_navios_v2
META_REPORT_TEMPLATE_LANGUAGE=pt_BR
# Mantenha falso ate o numero e o modelo de envio estarem aprovados na Meta.
RELATORIO_WHATSAPP_ATIVO=false

APS_URL=https://www.portodesantos.com.br/painel-de-monitoramento-das-operacoes-portuarias/
ATRACACOES_PROGRAMADAS_URL=https://www.portodesantos.com.br/informacoes-operacionais/operacoes-portuarias/navegacao-e-movimento-de-navios/atracacoes-programadas/
ATRACADOS_URL=https://www.portodesantos.com.br/informacoes-operacionais/operacoes-portuarias/navegacao-e-movimento-de-navios/atracados-porto-terminais/
# A Santos Pilots exige autenticacao. Informe apenas um endpoint autorizado.
PRATICAGEM_URL=

# Ative somente apos aplicar a migracao da fila e configurar o executor no GitHub.
ATUALIZACAO_CHAT_ATIVA=false

# Fonte obrigatória no cruzamento; endereço padrão da APS.
FUNDEADOS_URL=https://www.portodesantos.com.br/informacoes-operacionais/operacoes-portuarias/navegacao-e-movimento-de-navios/navios-fundeados/
