{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.analysis.typeCheckingMode": "basic",
  "files.exclude": {
    "**/__pycache__": true,
    ".codex-remote-attachments": true,
    ".contact_sheets": true,
    ".docx_review_*": true,
    ".docx_tmp_*": true,
    ".venv": true,
    "tmp": true
  },
  "search.exclude": {
    "tmp/**": true,
    ".venv/**": true,
    "output/**": true
  }
}
